# Copy to .env and fill in. All values are read by nichmah_agrovet/settings.py.

# --- Core ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=nicmah.co.ke,www.nicmah.co.ke
CSRF_TRUSTED_ORIGINS=https://nicmah.co.ke,https://www.nicmah.co.ke
TIME_ZONE=Africa/Nairobi

# --- Database ---
# SQLite (default, single-writer; fine for dev, not for a busy POS):
# DB_ENGINE=django.db.backends.sqlite3
# MySQL on cPanel (create the DB and user in cPanel > MySQL Databases first):
DB_ENGINE=django.db.backends.mysql
DB_NAME=cpaneluser_nicmah
DB_USER=cpaneluser_nicmah
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Cache ---
# Default is the file cache at <project>/cache. Override for Redis:
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# --- Email (cPanel mail account) ---
EMAIL_HOST=mail.nicmah.co.ke
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@nicmah.co.ke
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NICMAH <no-reply@nicmah.co.ke>
EMAIL_TIMEOUT=10

# --- Rate limiting ---
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
